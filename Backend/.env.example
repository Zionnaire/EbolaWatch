NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ebolawatch
# Signs session tokens (HS256). At least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Per address, for sign-in and the one-time link endpoints
AUTH_RATE_LIMIT_PER_MINUTE=20
INGEST_API_KEY=change-me-ingest-key-min-16
AUTHOR_HASH_SECRET=change-me-hash-secret-min-16
MODEL_MODE=mock
# The real model service delivers the three-class output (confirmed by the model developer): use threeclass-v0 for it.
# multilabel-v1 is what the in-process and mock-server fixtures default to.
MODEL_CONTRACT=multilabel-v1
MODEL_BASE_URL=http://localhost:4100
# Sent as the X-ML-API-Key header to the model service. Leave empty for the mock model.
MODEL_API_KEY=
# Texts longer than this are cut before they are sent (the model service documents 2000; it may change).
MODEL_MAX_TEXT_CHARS=2000
MODEL_TIMEOUT_MS=10000
MODEL_MOCK_MARKER=mock
MODEL_WARMUP_MAX_WAIT_MS=120000
# Who writes counter-narrative drafts: mock (canned text) or groq (AI, grounded in knowledge/ebola-facts.v1.json).
GENERATOR_MODE=mock
# Needed when GENERATOR_MODE=groq. Never commit it. List the models your key can use with: pnpm check:groq --models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000
KNOWLEDGE_FILE=knowledge/ebola-facts.v1.json
# ai = Groq merges the same claim across languages and names the dashboard's recurring claims (needs GROQ_API_KEY)
CLUSTER_REFINER=none
# true = the writer refuses until the fact base file says "status": "approved" (set this once NCDC signs it off)
KNOWLEDGE_REQUIRE_REVIEW=false
INGESTION_MODE=mock
QUEUE_CAP=500
OVERDUE_HOURS=48
MOCK_MODEL_PORT=4100
