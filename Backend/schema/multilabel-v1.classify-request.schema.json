{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "taxonomy_version": {
      "type": "string"
    },
    "items": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "language_hint": {
            "type": ["string", "null"]
          },
          "context_text": {
            "type": ["string", "null"]
          }
        },
        "required": ["item_id", "text", "platform", "language_hint", "context_text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["request_id", "taxonomy_version", "items"],
  "additionalProperties": false
}
