{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "warming", "degraded"]
    },
    "model_version": {
      "type": "string"
    },
    "taxonomy_version": {
      "type": "string"
    },
    "retry_after_seconds": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["status", "model_version", "taxonomy_version", "retry_after_seconds"],
  "additionalProperties": false
}
